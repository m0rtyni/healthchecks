environments:
  local:
    values:
      - ../values/local.yaml
    secrets:
      - ../secrets/healthchecks.sops.yaml

  production:
    values:
      - ../values/production.yaml
    secrets:
      - ../secrets/healthchecks.sops.yaml

---

helmDefaults:
  wait: true
  timeout: 600

releases:
  - name: healthchecks-db
    namespace: default
    chart: ../postgres_chart
    installed: {{ eq .Environment.Name "local" }}
    values:
      - ../postgres_chart/values.yaml
      - secret:
          dbPassword: {{ .Values.secret.dbPassword | quote }}

  - name: healthchecks
    namespace: default
    chart: ../helm_chart
    values:
      - ../helm_chart/values.yaml
      - ../values/{{ .Environment.Name }}.yaml
      - secret:
          dbPassword: {{ .Values.secret.dbPassword | quote }}
          djangoSecretKey: {{ .Values.secret.djangoSecretKey | quote }}
