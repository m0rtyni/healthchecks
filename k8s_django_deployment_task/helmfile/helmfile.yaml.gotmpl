
environments:
  local:
    values:
      - ../values/local.yaml
    secrets:
      - ../secrets/healthchecks.sops.yaml

  production:
    values:
      - ../values/production.yaml
    secrets:
      - ../secrets/healthchecks.sops.yaml

---

helmDefaults:
  wait: true
  timeout: 600

releases:
  - name: healthchecks
    namespace: default
    chart: ../helm_chart
    values:
      - ../helm_chart/values.yaml
      - ../values/{{ .Environment.Name }}.yaml
